# Silent Blue operator settings.
# Copy this file to .env in this directory, or to ~/.silentblue/.env
# A .env inside a repository you scan is ignored.
# Detect, ingest, and batch run without these values.
# Assess, remediate, and validate read SILENTBLUE_API_KEY.

# openai, anthropic, grok, or gemini. Aliases: gpt, claude, xai, google.
SILENTBLUE_PROVIDER=openai
SILENTBLUE_API_KEY=

# Leave the endpoint and model unset to use the provider default:
#   openai     https://api.openai.com/v1                                 gpt-6.1-terra
#   anthropic  https://api.anthropic.com/v1                              claude-sonnet-5-5
#   grok       https://api.x.ai/v1                                       grok-4.7
#   gemini     https://generativelanguage.googleapis.com/v1beta/openai   gemini-4-hydrogen
# Gemini, including Flash, uses that OpenAI-compatible URL. Set SILENTBLUE_MODEL
# to the Flash id. Leave SILENTBLUE_BASE_URL unset. The Google SDK root is a different request.
# An unlisted model leaves USD unknown until both prices below are set.
# SILENTBLUE_BASE_URL=
# SILENTBLUE_MODEL=

# Optional. The default is ~/.silentblue/state, which must sit outside the repository you scan.
# SILENTBLUE_STATE_DIR=

# Optional. USD per one million tokens. Set both to replace the dated list-price table.
# SILENTBLUE_PRICE_INPUT_PER_MILLION=
# SILENTBLUE_PRICE_OUTPUT_PER_MILLION=

# Optional assess ceilings. Defaults are 4 workers, 20 units, and 40 calls.
# SILENTBLUE_WORKERS=4
# SILENTBLUE_MAX_UNITS=20
# SILENTBLUE_MAX_CALLS=40
# SILENTBLUE_MAX_COST_USD=

# OSV advisory query. /scan osv and scan --osv POST to this https URL.
SILENTBLUE_OSV_URL=https://api.osv.dev/v1/querybatch

# Optional. CA bundle for that query. The file must sit outside the repository you scan.
# When this is unset, the query uses the system CA store. setup prints ca bundle: missing
# and the reason when no bundle can be loaded.
# SILENTBLUE_CA_BUNDLE=

# Optional deployment review. The URL is requested once. The snapshot stays outside the repository.
# SILENTBLUE_DEPLOY_URL=
# SILENTBLUE_DEPLOY_SNAPSHOT=
